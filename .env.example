# Fitti — environment template
#
# Copy to .env.local and fill in what you have. Never commit .env.local.
#
# The app is built to boot with NO keys at all. Absent keys switch features to
# their local/deterministic path rather than crashing, and the *presence* of a
# key is the switch rather than a separate flag — a flag can disagree with
# reality, a key cannot.

# --------------------------------------------------------------- supabase ---
# Postgres, auth, and RLS. Images do NOT live here (see Cloudflare below).
# Run: supabase start   -> prints local URL and keys for development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses every RLS policy in 0002_rls.sql.
# NEVER prefix with NEXT_PUBLIC. Every route using this must do its own
# ownership check first, because the database will no longer do it for you.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------- cloudflare ---
# R2 holds every image. Chosen over Supabase Storage because Supabase bills
# image transformations per origin image per month, which is $150/mo at 100
# users; R2 egress is $0. See docs/DECISIONS.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fitti
# The Worker that verifies the image JWT and serves from R2, e.g. img.fitti.app
NEXT_PUBLIC_IMAGE_HOST=
# HMAC secret for the short-lived image tokens. Generate with:
#   openssl rand -base64 32
IMAGE_TOKEN_SECRET=

# ----------------------------------------------------------------- vision ---
# Garment tagging. Attribute extraction runs on Gemini Flash-Lite at roughly
# $0.09 per 100 garments. Absent, ingest still produces a cutout and colors --
# it just leaves the attribute fields null for the user to fill if they care.
GEMINI_API_KEY=

# Cutout FALLBACK only. The iOS app does cutouts on-device with Vision for free;
# this is for web uploads and for when Vision finds no subject.
FAL_KEY=

# The stylist. Without it, outfit suggestions fall back to the deterministic
# scoring engine -- fully functional, just without the one-line "why".
ANTHROPIC_API_KEY=

# ------------------------------------------------------------- moderation ---
# omni-moderation-latest handles images and is free for API users. Leave blank
# and uploads skip moderation, which is fine for a private closet and NOT fine
# the day anything becomes shareable.
OPENAI_API_KEY=

# ---------------------------------------------------------- rate limiting ---
# Absent = every limiter passes, which is what a laptop wants. Set these before
# a single real person uses this: upload and inference are the two routes where
# somebody else can spend your money.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------- email ingest ---
# Inbound address per user: u_<slug>@in.fitti.app. Forwarding a store receipt is
# the single fastest way to add clothes, so this is worth wiring early.
RESEND_API_KEY=
INBOUND_EMAIL_DOMAIN=in.fitti.app
