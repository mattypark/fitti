// Copy to Secrets.xcconfig (gitignored) and fill in.
//
// Leave this file absent entirely and Fitti runs on its local mock auth — a
// working state, not a broken one.
//
// Get these from `supabase start` in the repo root. Note the // in the URL has to
// be escaped as $() for xcconfig, which otherwise treats // as a comment.

SUPABASE_URL = http:$()//127.0.0.1:54421
SUPABASE_ANON_KEY =
